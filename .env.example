# Copy to backend/.env (or export as environment variables). Every setting is optional.
# All names are prefixed HOSPICALL_ — see backend/app/config.py for the full list and defaults.

# --- Hospital facts the agent reads out (demo values) ---
HOSPICALL_HOSPITAL_NAME=City Hospital
HOSPICALL_HOSPITAL_ADDRESS=100 Health Avenue, opposite the city park
HOSPICALL_HOSPITAL_HOURS=Monday to Saturday, 8 AM to 8 PM
HOSPICALL_HOSPITAL_PHONE=040 5555 0100
HOSPICALL_EMERGENCY_NUMBER=108
HOSPICALL_CRISIS_NUMBER=14416

# --- LLM fallback (Ollama). Leave unreachable and HospiCall runs rules-only. ---
HOSPICALL_OLLAMA_URL=http://localhost:11434
HOSPICALL_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
HOSPICALL_LLM_TIMEOUT_SECONDS=20

# --- Voice (OmniVoice Studio). Leave unreachable and the UI falls back to browser speech. ---
HOSPICALL_OMNIVOICE_URL=http://localhost:3900

# --- Storage ---
# Defaults to <repo>/data/hospicall.db
# HOSPICALL_DB_PATH=/var/lib/hospicall/hospicall.db
HOSPICALL_AUTO_SEED=true

# --- Hardening ---
HOSPICALL_RATE_LIMIT_PER_MINUTE=120
# Enables GET /v1/admin/appointments and /v1/admin/audit (sent as X-API-Key). Unset = admin API disabled.
# HOSPICALL_ADMIN_API_KEY=change-me
# Keep uploaded caller audio on disk after transcription (default: delete immediately).
HOSPICALL_AUDIO_RETENTION=false
